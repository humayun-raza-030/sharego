# Core
APP_NAME=ShareGo
TIMEZONE=Asia/Karachi
CURRENCY=PKR
ENV=dev

# Database
DB_URL=sqlite:///./sharego.db

# Auth/JWT
JWT_SECRET=change_me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60

# OTP (email)
OTP_SENDER_EMAIL=no-reply@sharego.local
OTP_SMTP_HOST=localhost
OTP_SMTP_PORT=1025
OTP_SMTP_USER=
OTP_SMTP_PASS=
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=3
OTP_TTL_SECONDS=300

# Media
MEDIA_ROOT=./media
MEDIA_BASE_URL=/media

# MinIO (optional)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false

# Feature flags
FEATURE_ESCROW_SIM=true
FEATURE_AI_READONLY=true
